#!/usr/bin/with-contenv bashio
# ==============================================================================
# Configure the scanner addon
# ==============================================================================

bashio::log.info "Configuring Scanner Add-on..."

# Get configuration values
DEVICE_ID=$(bashio::config "device_id")
OUTPUT_FORMAT=$(bashio::config "output_format")
QUALITY=$(bashio::config "quality")
FILENAME_PATTERN=$(bashio::config "filename_pattern")
SAVE_TO=$(bashio::config "save_to")
SUBDIR=$(bashio::config "subdir")
RESOLUTION=$(bashio::config "resolution")
PRINTER_ADDRESS=$(bashio::config "printer_address")
PRINTER_NAME=$(bashio::config "printer_name")
TELEGRAM_ENABLED=$(bashio::config "telegram.enabled")
TELEGRAM_BOT_TOKEN=$(bashio::config "telegram.bot_token")
TELEGRAM_CHAT_ID=$(bashio::config "telegram.chat_id")
TELEGRAM_ADMIN_IDS=$(bashio::config "telegram.admin_ids")
TELEGRAM_CAPTION=$(bashio::config "telegram.caption")
TELEGRAM_USE_ALBUM=$(bashio::config "telegram.use_album")

# Create data directory if it doesn't exist
mkdir -p /data

# Create config.json file
bashio::log.info "Creating config.json file..."
cat > /data/options.json <<EOF
{
  "device_id": "$DEVICE_ID",
  "output_format": "$OUTPUT_FORMAT",
  "quality": $QUALITY,
  "filename_pattern": "$FILENAME_PATTERN",
  "save_to": "$SAVE_TO",
  "subdir": "$SUBDIR",
  "resolution": $RESOLUTION,
  "printer_address": "$PRINTER_ADDRESS",
  "printer_name": "$PRINTER_NAME",
  "telegram": {
    "enabled": $TELEGRAM_ENABLED,
    "bot_token": "$TELEGRAM_BOT_TOKEN",
    "chat_id": "$TELEGRAM_CHAT_ID",
    "admin_ids": "$TELEGRAM_ADMIN_IDS",
    "caption": "$TELEGRAM_CAPTION",
    "use_album": $TELEGRAM_USE_ALBUM
  }
}
EOF

bashio::log.info "Config.json created successfully"

# Configure avahi daemon
bashio::log.info "Configuring avahi daemon..."
mkdir -p /var/run/avahi-daemon
chmod 755 /var/run/avahi-daemon

# Configure dbus daemon
bashio::log.info "Configuring dbus daemon..."
mkdir -p /var/run/dbus
chmod 755 /var/run/dbus

bashio::log.info "Configuration complete"
